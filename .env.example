# Copy to .env and fill in. .env is gitignored and must never be committed.
# The same five variables go into the Vercel project as environment variables.

# LLMod.ai. Shared across the whole group; rotating it rotates it for everyone.
# Budget is $13 total.
LLMOD_API_KEY=

# Supabase. Project URL looks like https://abcdefghijkl.supabase.co
# Use the service_role key, not the anon key: seeding writes tables.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Pinecone. INDEX_HOST is the host shown on the index page, without https://
# It looks like barmate-knowledge-abc1234.svc.aped-4627-b74a.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX_HOST=
